    "/api/attendance/check-in": {
      "post": {
        "summary": "Employee check-in",
        "description": "Record employee check-in for the current day based on configured timezone.",
        "responses": {
          "200": {
            "description": "Check-in recorded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "attendance": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "date": {
                          "type": "string",
                          "format": "date",
                          "example": "2026-08-22"
                        },
                        "checkIn": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "checkOut": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "PRESENT",
                            "ABSENT",
                            "LATE",
                            "HALF_DAY"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "date",
                        "checkIn",
                        "status"
                      ]
                    }
                  },
                  "required": [
                    "attendance"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/attendance/check-out": {
      "post": {
        "summary": "Employee check-out",
        "description": "Record employee check-out for the current day.",
        "responses": {
          "200": {
            "description": "Check-out recorded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "attendance": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "date": {
                          "type": "string",
                          "format": "date",
                          "example": "2026-08-22"
                        },
                        "checkIn": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "checkOut": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "PRESENT",
                            "ABSENT",
                            "LATE",
                            "HALF_DAY"
                          ]
                        }
                      },
                      "required": [
