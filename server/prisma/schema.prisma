datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String           @id @default(uuid()) @db.Uuid
  employeeId              String           @unique
  email                   String           @unique
  passwordHash            String
  role                    String           @default("EMPLOYEE")
  emailVerified           Boolean          @default(false)
  verificationToken       String?          @unique
  verificationTokenExpiry DateTime?
  passwordResetToken      String?          @unique
  passwordResetExpiry     DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  sessions                Session[]
  permissions             UserPermission[]
  employee                Employee?
  leaveRequests           LeaveRequest[]
  salaryStructure         SalaryStructure?
  salarySlips             SalarySlip[]
  notifications           Notification[]

  @@map("users")
}

model Employee {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String    @unique
  firstName        String
  lastName         String
  phone            String?
  department       String?
  designation      String?
  joiningDate      DateTime?
  profileImage     String?
  address          String?
  employmentStatus String?   @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  attendances      Attendance[]

  @@map("employees")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model UserPermission {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource  String
  action    String
  createdAt DateTime @default(now())

  @@unique([userId, resource, action])
  @@map("user_permissions")
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  employeeId     String           @db.Uuid
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate DateTime         @db.Date
  checkIn        DateTime
  checkOut       DateTime?
  status         AttendanceStatus @default(PRESENT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([employeeId])
  @@index([attendanceDate])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model LeaveRequest {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String
  user        User     @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  leaveType   String   // "PAID", "SICK", "UNPAID"
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "CANCELLED"
  remarks     String?
  approvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("leave_requests")
}

model SalaryStructure {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @unique
  user         User     @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  basicSalary  Float    @default(0.0)
  allowances   Float    @default(0.0)
  deductions   Float    @default(0.0)
  department   String   @default("Engineering")
  designation  String   @default("Software Engineer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("salary_structures")
}

model SalarySlip {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String
  user         User     @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  month        String   // format "YYYY-MM"
  basicSalary  Float
  allowances   Float
  deductions   Float
  netSalary    Float
  department   String
  designation  String
  status       String   @default("PAID")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, month])
  @@map("salary_slips")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // "LEAVE_REQUEST" | "LEAVE_STATUS" | "PAYROLL_GENERATED" | "SYSTEM"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}
